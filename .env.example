# Smart Security System - Environment Template
# Copy this file to .env and fill in your own values.
# IMPORTANT: Never commit .env (it contains secrets).

# Supabase (optional, but recommended for person/attendance metadata)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chatbot (optional)
GROQ_API_KEY=

# Optional (recommended): protect the whole app with browser Basic Auth.
# If either value is empty, auth is disabled.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional: basic per-IP rate limits (0 disables a limit)
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_VIDEO_PER_MIN=5

# If you run behind a reverse proxy that sets X-Forwarded-For, set to 1
TRUST_PROXY=0

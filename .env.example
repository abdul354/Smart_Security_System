# --- Required (if you enable Supabase syncing) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: Chatbot (Groq) ---
GROQ_API_KEY=

# --- Optional: Security (recommended for anything public) ---
# If unset, auth is disabled.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- Optional: Rate limiting ---
# Set to 0 to disable a rule.
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_VIDEO_PER_MIN=30

# If running behind a reverse proxy (Render/Fly/Nginx) that sets X-Forwarded-For,
# set TRUST_PROXY=1 so rate limiting uses the real client IP.
TRUST_PROXY=0

# --- Camera source ---
# For local webcam: 0 (or 1, 2...)
# For IP camera / NVR: rtsp://user:pass@host:554/stream
# For HTTP streams: http://...
CAMERA_SRC=0

# --- CORS (only needed if you host frontend separately) ---
# Comma-separated origins, e.g. https://your-frontend.vercel.app,https://example.com
CORS_ORIGINS=
